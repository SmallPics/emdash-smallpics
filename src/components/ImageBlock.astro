---
import Image from './Image.astro';
import { imageBlockValue, type ImageBlock } from '../../dist/index.js';

interface Props {
	node: ImageBlock;
	sizes?: string;
}

const { node, sizes } = Astro.props;

const media = imageBlockValue(node);

const link = typeof node.link === 'string' ? { href: node.link } : node.link;

const href = link?.href?.trim();

const safeHref =
	href &&
	!/[\u0000-\u0020\\]/.test(href) &&
	(/^https?:\/\//i.test(href) || /^\/(?!\/)/.test(href) || href.startsWith('#'))
		? href
		: undefined;

const blank =
	safeHref &&
	!safeHref.startsWith('#') &&
	link &&
	'blank' in link &&
	link.blank;

const props = {
	image: media,
	width: node.displayWidth,
	height: node.displayHeight,
	sizes,
	title: node.title,
};
---

<figure
	class:list={[
		'smallpics-figure',
		node.alignment && `smallpics-align-${node.alignment}`,
	]}
>
	{safeHref ? (
		<a
			href={safeHref}
			target={blank ? '_blank' : undefined}
			rel={blank ? 'noopener noreferrer' : undefined}
		>
			<Image {...props} />
		</a>
	) : (
		<Image {...props} />
	)}
	{node.caption && <figcaption>{node.caption}</figcaption>}
</figure>
<style>
	figure {
		margin: 1.5rem 0;
	}
	figure :global(img) {
		max-width: 100%;
		height: auto;
	}
	figcaption {
		margin-top: 0.5rem;
		text-align: center;
		font-size: 0.875em;
	}
	.smallpics-align-left {
		float: left;
		max-width: 50%;
		margin-right: 1.5rem;
	}
	.smallpics-align-right {
		float: right;
		max-width: 50%;
		margin-left: 1.5rem;
	}
	.smallpics-align-center {
		width: fit-content;
		margin-inline: auto;
	}
	.smallpics-align-wide,
	.smallpics-align-full {
		width: 100%;
	}
	@media (max-width: 640px) {
		.smallpics-align-left,
		.smallpics-align-right {
			float: none;
			max-width: 100%;
			margin-inline: 0;
		}
	}
</style>
