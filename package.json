{
	"name": "emdash-smallpics",
	"version": "0.1.0",
	"description": "Small Pics image delivery for EmDash",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/SmallPics/emdash-smallpics.git"
	},
	"files": [
		"dist",
		"src/components",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./Image": "./src/components/Image.astro",
		"./PortableText": "./src/components/PortableText.astro",
		"./Gallery": "./src/components/Gallery.astro"
	},
	"engines": {
		"node": ">=22.16.0"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"check": "tsc --noEmit && astro check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"pretest": "npm run build",
		"prepack": "npm run build"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/node": "^11.1.7",
		"@astrojs/react": "^7.0.1",
		"@types/node": "^22.0.0",
		"astro": "^7.3.8",
		"emdash": "^1.2.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"typescript": "^6.0.0",
		"vitest": "^4.0.0"
	},
	"peerDependencies": {
		"astro": "^7.3.8",
		"emdash": "^1.2.0"
	},
	"dependencies": {
		"astro-smallpics": "^0.1"
	}
}
