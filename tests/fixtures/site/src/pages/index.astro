---
import { Image as AstroImage } from 'astro:assets';
import Image from '../../../../../src/components/Image.astro';
import PortableText from '../../../../../src/components/PortableText.astro';

export const prerender = true;

const media = {
	id: 'fixture',
	meta: { storageKey: 'bird.jpg' },
	width: 1200,
	height: 800,
	alt: 'Bird',
	focalX: 0.25,
	focalY: 0.75,
};

const content = [
	{
		_type: 'image',
		_key: 'image',
		asset: { _ref: 'fixture', url: '/_emdash/api/media/file/bird.jpg' },
		alt: 'Rich text bird',
		width: 1200,
		height: 800,
		displayWidth: 600,
	},
	{
		_type: 'gallery',
		_key: 'gallery',
		columns: 2,
		images: [
			{
				_type: 'image',
				_key: 'gallery-image',
				asset: {
					id: 'fixture',
					meta: { storageKey: 'bird.jpg' },
					width: 1200,
					height: 800,
				},
				alt: 'Gallery bird',
			},
		],
	},
];
---

<html lang="en">
	<head>
		<title>Small Pics integration fixture</title>
	</head>
	<body>
		<AstroImage
			src="bird.jpg"
			width={400}
			height={300}
			widths={[200, 400]}
			alt="Astro bird"
			format="webp"
		/>
		<Image
			image={media}
			width={400}
			height={400}
			fit="cover"
			smallpics={{
				trim: 'either',
				trimPadding: 8,
				border: [12, 'transparent', 'expand'],
				format: 'png',
			}}
			priority
		/>
		<PortableText value={content} />
	</body>
</html>
